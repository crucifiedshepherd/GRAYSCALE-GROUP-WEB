---
interface Props {
  title: string;
  subtitle: string;
  href?: string;
  soon?: boolean;
}
const { title, subtitle, href, soon = false } = Astro.props;
---
<a class="door fx-chroma" href={soon ? undefined : href} aria-disabled={soon ? 'true' : undefined}>
  <h2>{title}</h2>
  <p>{subtitle}</p>
  {soon && <span class="fx-stamp">скоро</span>}
</a>

<style>
  .door {
    display: block;
    border: 1px solid var(--c-gray-deep);
    padding: var(--s-5) var(--s-4);
    color: var(--c-paper);
    text-decoration: none;
    background: var(--c-black);
    transition: border-color .15s;
  }
  .door:hover { border-color: var(--c-paper); }
  .door[aria-disabled='true'] { opacity: .55; pointer-events: none; }
  h2 {
    font-family: var(--f-serif);
    font-size: clamp(28px, 4vw, 48px);
    margin: 0 0 var(--s-2);
    text-transform: uppercase;
  }
  p { font-family: var(--f-mono); color: var(--c-gray); margin: 0 0 var(--s-3); }
</style>
