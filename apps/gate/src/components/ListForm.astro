<form id="list-form">
  <label class="label" for="handle">встать в список своих</label>
  <div class="row">
    <input id="handle" name="handle" type="text" placeholder="@tg или email" required />
    <button type="submit">я свой</button>
  </div>
  <p class="note" id="list-note" hidden>принято. свои найдут.</p>
</form>

<script>
  const form = document.getElementById('list-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>('#handle')!;
    const list = JSON.parse(localStorage.getItem('gg-list') ?? '[]');
    list.push(input.value.trim());
    localStorage.setItem('gg-list', JSON.stringify(list));
    form.querySelector('.row')!.setAttribute('hidden', '');
    document.getElementById('list-note')!.removeAttribute('hidden');
  });
</script>

<style>
  form { max-width: 560px; margin: 0 auto; padding: var(--s-5) var(--s-3); }
  .label { font-family: var(--f-caps); text-transform: uppercase; letter-spacing: .08em; }
  .row { display: flex; gap: var(--s-2); margin-top: var(--s-3); }
  input {
    flex: 1;
    background: transparent;
    border: 1px solid var(--c-gray-deep);
    color: var(--c-paper);
    font-family: var(--f-mono);
    padding: var(--s-2) var(--s-3);
  }
  input:focus { outline: none; border-color: var(--c-red); }
  button {
    background: var(--c-paper);
    color: var(--c-black);
    border: none;
    font-family: var(--f-caps);
    text-transform: uppercase;
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
  }
  button:hover { background: var(--c-red); color: var(--c-paper); }
  .note { font-family: var(--f-mono); color: var(--c-red); }
</style>
