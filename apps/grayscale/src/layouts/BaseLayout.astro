---
import '@grayscale/ui/tokens.css';
import '@grayscale/ui/fx.css';
import '@grayscale/ui/fonts.css';
import '@fontsource/old-standard-tt/400.css';
import '@fontsource/old-standard-tt/700.css';
import '@fontsource/oswald/400.css';
import '@fontsource/oswald/600.css';
import '@fontsource/saira-stencil-one/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Perf from '../components/Perf.astro';

interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="fx-grain">
    <Header />
    <slot />
    <Footer />
    <Perf />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--c-black);
    color: var(--c-paper);
    font-family: var(--f-quiet);
  }
  ::selection { background: var(--c-red); color: var(--c-paper); }
  a { color: inherit; }
</style>
