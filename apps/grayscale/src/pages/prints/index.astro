---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const prints = await getCollection('prints');
const archive = prints
  .filter((p) => p.data.status !== 'available')
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="архив принтов — GRAYSCALE">
  <main>
    <h1>архив принтов</h1>
    <div class="tape">
      {archive.map((p) => (
        <section class="slide">
          <div class:list={['photo', { 'fx-halftone': !p.data.images[0], burned: p.data.status === 'burned', wip: p.data.status === 'soon', burn: p.data.status === 'burned' }]}>
            {p.data.images[0] && <img class="shot" src={p.data.images[0]} alt={p.data.title} />}
            {(p.data.status === 'sold-out' || p.data.status === 'burned') && <span class="x">✕</span>}
            {p.data.status === 'burned' && <img class="fire-gif" src="/media/fire.gif" alt="" />}
            {p.data.status === 'soon' && <span class="wip-label">в разработке</span>}
          </div>
          <div class="info">
            <h2 class:list={[{ stencil: p.id === 'russia-crisis-veteran' }]}>{p.data.title}</h2>
            {p.data.released && <p class="date">{p.data.released}</p>}
            <p class="desc">{p.data.desc_ru}</p>
            <a class="btn" href={`/prints/${p.id}`}>смотреть</a>
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  h1 { font-family: var(--f-serif); text-transform: uppercase; padding: var(--s-4) var(--s-4) 0; margin: 0; }
  .tape { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-4); max-width: 960px; margin: 0 auto; }
  .slide {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--s-4);
    border: 1px solid var(--c-gray-deep);
    padding: var(--s-4);
    min-height: 70vh;
    align-content: center;
    scroll-snap-align: start;
  }
  @media (max-width: 760px) { .slide { grid-template-columns: 1fr; min-height: auto; } }
  .photo {
    position: relative;
    min-height: 320px;
    border: 1px solid var(--c-gray-deep);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
  }
  .x { color: var(--c-red); font-size: 140px; line-height: 1; font-family: var(--f-mono); z-index: 3; }
  .photo.wip {
    border-style: dashed;
    background: repeating-linear-gradient(45deg, transparent 0 10px, rgba(138, 138, 138, .12) 10px 11px);
  }
  .wip-label { font-family: var(--f-mono); color: var(--c-gray); letter-spacing: .2em; }
  h2 { font-family: var(--f-serif); text-transform: uppercase; margin: 0 0 var(--s-1); }
  .stencil { font-family: var(--f-stencil); letter-spacing: .04em; }
  .date { font-family: var(--f-mono); color: var(--c-rust); margin: 0 0 var(--s-2); }
  .desc { color: var(--c-gray); }
  .btn {
    display: inline-block;
    margin-top: var(--s-3);
    padding: var(--s-2) var(--s-4);
    background: var(--c-paper);
    color: var(--c-black);
    font-family: var(--f-caps);
    text-transform: uppercase;
    text-decoration: none;
  }
  .btn:hover { background: var(--c-red); color: var(--c-paper); }
</style>

<style is:global>
  html { scroll-snap-type: y proximity; }
</style>
