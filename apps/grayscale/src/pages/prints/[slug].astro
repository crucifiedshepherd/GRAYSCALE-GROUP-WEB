---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stamp from '../../components/Stamp.astro';
import Barcode from '../../components/Barcode.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const prints = await getCollection('prints');
  return prints.map((p) => ({ params: { slug: p.id } }));
}

const prints = await getCollection('prints');
const entry = prints.find((p) => p.id === Astro.params.slug)!;
const { title, status, sizes, edition, colors, series, desc_ru, price, images } = entry.data;
const burned = status === 'burned';
const wip = status === 'soon';
const stencil = entry.id === 'russia-crisis-veteran';
const { Content } = await render(entry);
---
<BaseLayout title={`${title} — GRAYSCALE`}>
  <main class="wrap">
    <p class="crumbs"><a href="/prints">архив</a> / {title}</p>
    <div class="cols">
      <div class:list={['art', { 'fx-halftone': !images[0], burned, wip }]}>
        {images[0] && <img class="shot" src={images[0]} alt={title} />}
        {(status === 'sold-out' || burned) && <span class="x">✕</span>}
        {burned && <span class="fire" aria-hidden="true"></span>}
        {wip && <span class="wip-label">в разработке</span>}
      </div>
      <div>
        <h1 class:list={[{ stencil }]}>{title}</h1>
        <p class="desc">{desc_ru}</p>
        <ul class="meta">
          <li>серия: {series}</li>
          <li>размеры: {sizes}</li>
          {edition && <li>тираж: {edition}</li>}
          <li>цвета: {colors}</li>
        </ul>
        {status === 'sold-out' && <Stamp text="sold out" />}
        {burned && <Stamp text="сгорел" />}
        {wip && <Stamp text="в разработке" />}
        <Barcode />
      </div>
    </div>

    {images.length > 1 && (
      <div class="shots">
        {images.map((s) => <img class="shot-big" src={s} alt={title} />)}
      </div>
    )}

    <section class="body"><Content /></section>

    <section class="order">
      {status === 'available' ? (
        <>
          <p class="price-big">{price ?? 'цена по запросу'}</p>
          <a class="order-btn" href="https://t.me/grayscalebrand" target="_blank" rel="noopener">заказать в telegram</a>
          <p class="note">заказы — только через telegram. своих найдём.</p>
        </>
      ) : (
        <p class="note">вещь в архиве. не продаётся.</p>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .wrap { max-width: 1000px; margin: 0 auto; padding: var(--s-5) var(--s-3); }
  .crumbs { font-family: var(--f-mono); color: var(--c-gray); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
  .art {
    position: relative;
    height: 320px;
    border: 1px solid var(--c-gray-deep);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
  }
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); margin-top: var(--s-4); }
  @media (max-width: 760px) { .shots { grid-template-columns: 1fr; } }
  .shot-big {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border: 1px solid var(--c-gray-deep);
    filter: grayscale(1) contrast(1.15);
  }
  .x { color: var(--c-red); font-size: 140px; line-height: 1; font-family: var(--f-mono); z-index: 2; }
  .fire {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 55%;
    background:
      radial-gradient(45% 60% at 18% 100%, rgba(255, 200, 80, .95), transparent 70%),
      radial-gradient(55% 65% at 50% 100%, rgba(255, 120, 40, .9), transparent 72%),
      radial-gradient(45% 60% at 82% 100%, rgba(193, 18, 31, .85), transparent 70%),
      linear-gradient(to top, rgba(255, 220, 120, .95), rgba(255, 120, 40, .75) 45%, transparent 85%);
    filter: blur(2px);
    mix-blend-mode: screen;
    animation: fire 1.1s infinite alternate ease-in-out;
    z-index: 1;
  }
  @keyframes fire {
    from { transform: scaleY(1); opacity: .95; }
    to { transform: scaleY(1.12); opacity: .8; }
  }
  .art.wip {
    border-style: dashed;
    background: repeating-linear-gradient(45deg, transparent 0 10px, rgba(138, 138, 138, .12) 10px 11px);
  }
  .wip-label { font-family: var(--f-mono); color: var(--c-gray); letter-spacing: .2em; }
  h1 { font-family: var(--f-serif); text-transform: uppercase; }
  .stencil { font-family: var(--f-stencil); letter-spacing: .04em; }
  .desc { color: var(--c-gray); }
  .meta { font-family: var(--f-mono); color: var(--c-gray); list-style: none; padding: 0; }
  .meta li { margin-bottom: var(--s-1); }
  .body { margin-top: var(--s-5); font-family: var(--f-quiet); }
  .order {
    margin-top: var(--s-6);
    padding: var(--s-6) var(--s-3);
    border-top: 1px dashed var(--c-gray-deep);
    text-align: center;
  }
  .price-big { font-family: var(--f-caps); font-size: clamp(32px, 5vw, 56px); margin: 0 0 var(--s-3); }
  .order-btn {
    display: inline-block;
    padding: var(--s-3) var(--s-6);
    background: var(--c-red);
    color: var(--c-paper);
    font-family: var(--f-caps);
    text-transform: uppercase;
    font-size: 20px;
    text-decoration: none;
  }
  .order-btn:hover { background: var(--c-paper); color: var(--c-black); }
  .note { font-family: var(--f-mono); color: var(--c-gray); }
</style>
