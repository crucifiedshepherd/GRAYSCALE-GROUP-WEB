---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breakthrough from '../components/Breakthrough.astro';
import Marquee from '../components/Marquee.astro';
import PrintCard from '../components/PrintCard.astro';
import { getCollection } from 'astro:content';

const prints = await getCollection('prints');
const onSale = prints
  .filter((p) => p.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="GRAYSCALE — одежда для своих">
  <Breakthrough />
  <main>
    <section class="hero">
      <h1>Оттенки Серого</h1>
      <p class="sub">одежда для своих.</p>
    </section>
    <Marquee />
    <section class="drop">
      <h2>в продаже</h2>
      <div class="grid">
        {onSale.map((p) => <PrintCard entry={p} />)}
      </div>
    </section>
    <section id="philosophy" class="philosophy">
      <p class="line">мы — оттенки серого.</p>
      <div class="frame">
        <span class="fx-stamp">в разработке</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { text-align: center; padding: var(--s-6) var(--s-3) var(--s-4); }
  .hero h1 {
    font-family: var(--f-serif);
    font-weight: 700;
    font-size: clamp(36px, 6vw, 72px);
    margin: 0;
  }
  .sub { font-family: var(--f-mono); color: var(--c-gray); }
  .drop { max-width: 1100px; margin: 0 auto; padding: var(--s-5) var(--s-3); }
  .drop h2 { font-family: var(--f-caps); text-transform: uppercase; letter-spacing: .08em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--s-4); }
  .philosophy { text-align: center; padding: var(--s-6) var(--s-3); }
  .line {
    font-family: var(--f-caps);
    text-transform: uppercase;
    color: var(--c-gray);
    margin: 0 0 var(--s-4);
  }
  .frame {
    border: 1px dashed var(--c-gray-deep);
    max-width: 560px;
    margin: 0 auto;
    padding: var(--s-6);
  }
</style>
