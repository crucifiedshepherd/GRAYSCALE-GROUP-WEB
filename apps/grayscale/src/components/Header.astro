<header>
  <a class="logo fx-chroma" href="/">GRAYSCALE</a>
  <nav>
    <a href="/prints">архив</a>
    <a href="/#philosophy">философия</a>
    <a href="https://t.me/grayscalebrand" target="_blank" rel="noopener">telegram</a>
  </nav>
  <span class="quiet" id="quiet">grayscale</span>
</header>
<img id="madonna" src="/media/madonna.png" alt="мадонна плачет кровью" />

<script>
  const quiet = document.getElementById('quiet')!;
  const madonna = document.getElementById('madonna')!;
  let n = 0;
  quiet.addEventListener('click', () => {
    n += 1;
    if (n === 3) {
      document.body.classList.toggle('xray');
      n = 0;
    }
  });
  madonna.addEventListener('click', () => {
    document.body.classList.remove('xray');
    n = 0;
  });
</script>

<style>
  header {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--c-gray-deep);
  }
  .logo {
    font-family: var(--f-serif);
    font-weight: 700;
    font-size: 28px;
    text-decoration: none;
    text-transform: uppercase;
  }
  nav { display: flex; gap: var(--s-3); font-family: var(--f-mono); }
  nav a { text-decoration: none; color: var(--c-gray); }
  nav a:hover { color: var(--c-paper); }
  .quiet {
    margin-left: auto;
    font-family: var(--f-mono);
    text-transform: lowercase;
    color: var(--c-gray-deep);
    cursor: pointer;
    user-select: none;
  }
  #madonna { display: none; }
  body.xray #madonna {
    display: block;
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: min(240px, 40vw);
    z-index: 350;
    cursor: pointer;
    border: 3px solid var(--c-red);
    filter: grayscale(1) contrast(1.1);
  }
  body.xray .quiet {
    color: var(--c-paper);
    text-shadow: 2px 0 rgba(193, 18, 31, .8), -2px 0 rgba(0, 120, 255, .7);
    animation: quietflicker 1.6s infinite steps(2);
  }
  @keyframes quietflicker { 50% { opacity: .5; } }
</style>

<style is:global>
  body.xray {
    --c-black: #f2f2f2;
    --c-paper: #0a0a0a;
    --c-gray: #666666;
    --c-gray-deep: #bbbbbb;
  }
  body.xray::before {
    content: 'ТЫ СВОЙ';
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 300;
    font-family: var(--f-stencil);
    color: var(--c-red);
    border: 3px solid var(--c-red);
    padding: 4px 12px;
    transform: rotate(6deg);
  }
</style>
