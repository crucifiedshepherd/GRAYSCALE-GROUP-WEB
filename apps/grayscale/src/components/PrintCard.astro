---
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'prints'>; }
const { entry } = Astro.props;
const { title, status, sizes, edition, released, price, images } = entry.data;
const burned = status === 'burned';
const wip = status === 'soon';
const stencil = entry.id === 'russia-crisis-veteran';
---
<a href={`/prints/${entry.id}`} class="card fx-sticker fx-chroma">
  <div class:list={['art', { 'fx-halftone': !images[0], burned, wip, burn: burned }]}>
    {images[0] && <img class="shot" src={images[0]} alt={title} />}
    {(status === 'sold-out' || burned) && <span class="x">✕</span>}
    {burned && <img class="fire-gif" src="/media/fire.gif" alt="" />}
    {wip && <span class="wip-label">в разработке</span>}
    {burned && <span class="fx-stamp burn-stamp">сгорел</span>}
  </div>
  <h3 class:list={[{ stencil }]}>{title}</h3>
  {released && <p class="date">{released}</p>}
  <p class="meta">{sizes}{edition ? ` / тираж ${edition}` : ''}</p>
  {price && <p class="price">{price}</p>}
  {status === 'sold-out' && <span class="fx-stamp">sold out</span>}
  {wip && <span class="fx-stamp">в разработке</span>}
</a>

<style>
  .card { display: block; padding: var(--s-3); text-decoration: none; background: var(--c-black); }
  .art {
    position: relative;
    height: 220px;
    border: 1px solid var(--c-gray-deep);
    display: grid;
    place-items: center;
    margin-bottom: var(--s-3);
    overflow: hidden;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
  }
  .x { color: var(--c-red); font-size: 140px; line-height: 1; font-family: var(--f-mono); z-index: 3; }
  .burn-stamp { position: absolute; bottom: var(--s-2); right: var(--s-2); z-index: 3; }
  .art.wip {
    border-style: dashed;
    background: repeating-linear-gradient(45deg, transparent 0 10px, rgba(138, 138, 138, .12) 10px 11px);
  }
  .wip-label { font-family: var(--f-mono); color: var(--c-gray); letter-spacing: .2em; }
  h3 { font-family: var(--f-serif); text-transform: uppercase; margin: 0 0 var(--s-1); }
  .stencil { font-family: var(--f-stencil); letter-spacing: .04em; }
  .date { font-family: var(--f-mono); color: var(--c-rust); margin: 0 0 var(--s-1); letter-spacing: .1em; }
  .meta { font-family: var(--f-mono); color: var(--c-gray); margin: 0; }
  .price { font-family: var(--f-caps); letter-spacing: .06em; margin: var(--s-1) 0 0; }
  .fx-stamp { margin-top: var(--s-2); }
</style>
